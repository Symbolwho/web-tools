{$DOMAIN} {
  root * /srv/site
  encode zstd gzip

  tls {
    dns cloudflare {env.CLOUDFLARE_API_TOKEN}
  }

  @hashedAssets path_regexp hashed ^/assets/.+\.(?:css|js|mjs|json|svg|png|jpg|jpeg|gif|webp|ico|woff|woff2)$
  @entrypoint path / /index.html

  header @entrypoint Cache-Control "no-cache, max-age=0, must-revalidate"
  header @hashedAssets Cache-Control "public, max-age=31536000, immutable"

  file_server
}
